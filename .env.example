# Comma-separated Solana JSON-RPC HTTP endpoints. Every getTransaction call
# picks one at random, so load is spread across all of them instead of
# hammering a single provider's requests-per-second limit.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated Solana JSON-RPC WebSocket endpoints, used for logsSubscribe.
# Leave empty to derive them from SOLANA_RPC_URLS (http(s) -> ws(s)).
# NOTE: not every provider/plan enables logsSubscribe on its WS gateway (e.g.
# Alchemy's default free-tier WS endpoint rejects it with "Method not
# found") - the public endpoint below always supports it, and is a safe
# default/fallback even if you add a paid provider's WS URL too.
SOLANA_WS_URLS=wss://api.mainnet-beta.solana.com

# processed = fastest (unconfirmed), confirmed = safer, finalized = slowest.
# Use "processed" or "confirmed" for live tracking - never "finalized".
SOLANA_COMMITMENT=processed

# Comma-separated wallet addresses to seed on startup (upserted into MongoDB
# as Traders; node src/tracker.js also accepts addresses as CLI args). Once
# running, add/remove traders via the dashboard - this is just a convenience
# for first boot / scripting.
TRACKED_ADDRESSES=

# Local MongoDB (works with a plain local install, no replica set needed -
# the tracker polls for trader changes rather than using change streams).
# Swap for a cloud connection string later; nothing else needs to change.
MONGODB_URI=mongodb://127.0.0.1:27017/pumpfun_tracker

# Used to look up a token's current market cap/reserves for mark-to-market
# holdings value. See db/pumpFunApi.js.
PUMP_FUN_API_BASE=https://frontend-api-v3.pump.fun
