# Comma-separated Solana JSON-RPC HTTP endpoints. Every getTransaction call
# picks one at random, so load is spread across all of them instead of
# hammering a single provider's requests-per-second limit.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated Solana JSON-RPC WebSocket endpoints, used for logsSubscribe.
# Leave empty to derive them from SOLANA_RPC_URLS (http(s) -> ws(s)).
# NOTE: not every provider/plan enables logsSubscribe on its WS gateway (e.g.
# Alchemy's default free-tier WS endpoint rejects it with "Method not
# found") - the public endpoint below always supports it, and is a safe
# default/fallback even if you add a paid provider's WS URL too.
SOLANA_WS_URLS=wss://api.mainnet-beta.solana.com

# processed = fastest (unconfirmed), confirmed = safer, finalized = slowest.
# Use "processed" or "confirmed" for live tracking - never "finalized".
SOLANA_COMMITMENT=processed

# Comma-separated wallet addresses to seed on startup (upserted into MongoDB
# as Traders; node src/tracker.js also accepts addresses as CLI args). Once
# running, add/remove traders via the dashboard - this is just a convenience
# for first boot / scripting.
TRACKED_ADDRESSES=

# Local MongoDB (works with a plain local install, no replica set needed -
# the tracker polls for trader changes rather than using change streams).
# Swap for a cloud connection string later; nothing else needs to change.
MONGODB_URI=mongodb://127.0.0.1:27017/pumpfun_tracker

# Used to look up a token's current market cap/reserves for mark-to-market
# holdings value. See db/pumpFunApi.js.
PUMP_FUN_API_BASE=https://frontend-api-v3.pump.fun

# Signs dashboard session cookies (REQUIRED - the dashboard refuses to serve
# anything without it). At least 32 random characters, different on every
# server, never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Encrypts the two-factor (authenticator app) secrets stored in MongoDB. REQUIRED to turn two-factor on. At least 32 random
# characters, different from SESSION_SECRET, never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Do NOT change it once accounts use two-factor - their stored secrets could no longer be decrypted (recover with
# `npm run user -- reset-2fa <username>`).
TOTP_ENCRYPTION_KEY=

# Encrypts live-wallet private keys stored in MongoDB (AES-256-GCM). REQUIRED to create live wallets. At least 32 random
# characters, different from SESSION_SECRET and TOTP_ENCRYPTION_KEY, never committed. Keep a backup somewhere safe: without it
# the stored keys can never be decrypted. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Do NOT change it once wallets exist.
WALLET_ENCRYPTION_KEY=

# Live wallets send trades through Jito (https://docs.jito.wtf/lowlatencytxnsend/). Optional:
# JITO_BLOCK_ENGINES: comma-separated block engine URLs in order of preference (default: all nine public regions).
# JITO_BLOCK_ENGINES=https://frankfurt.mainnet.block-engine.jito.wtf,https://ny.mainnet.block-engine.jito.wtf
# JITO_AUTH_UUID: an approved Jito auth key, for a higher rate limit than the default 1 request/second/IP/region.
# JITO_AUTH_UUID=

# Signature of a real, long-lived mainnet transaction. The /rpc page's Test buttons fetch it with getTransaction (up to 5
# tries, 1.5s apart - one success passes) to check an endpoint works. Without it, tests report "Not tested".
RPC_TEST_SIGNATURE=
